# -----------------------------------------------------------------------------------------------------------------
# This file specifies tests to be blocked on specific GPU-s and for specific cuDNN library versions.
#
# File format:
# test_name : comma_separated_sm_architecures : comma_separated_cudnn_versions # comment or bug_link
#
# For example:
# test_sdpa_random_bwd[BWD-MHA-inner_random-torch.bfloat16-test64] : SM_90, SM_100 : 91100 # https://nvbugs/123456
# test_sdpa_random_bwd[BWD-MHA-inner_random-torch.bfloat16-test65] : SM_100 : 91100, 91000 
# test_sdpa_random_bwd[BWD-MHA-inner_random-torch.bfloat16-test66] : SM_80   # block on SM_80 for any cudnn version
# test_sdpa_random_bwd[BWD-MHA-inner_random-torch.bfloat16-test67] : : 90000 # block on any GPU when cudnn 9.0 
# test_sdpa_random_bwd[BWD-MHA-inner_random-torch.bfloat16-test68] # always block this test
# -----------------------------------------------------------------------------------------------------------------

# https://nvbugs/5364384, Segmentation faults on Blackwell
test_sdpa_random_bwd[BWD-MHA-inner_random-torch.float16-test22]                : SM_100 : 91100,91200
test_sdpa_random_bwd_rgged[BWD_RAGGED_-GQA-inner_random-torch.bfloat16-test11] : SM_100 : 91100,91200
test_sdpa_random_bwd_ragged[BWD_RAGGED_-GQA-inner_random-torch.bfloat16-test11] : SM_100 : 91100,91200

