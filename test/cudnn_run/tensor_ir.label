<SmallMatMulShapeK>
    kv=gemm_K 4:
    kv=gemm_K 8:
    kv=gemm_K 16:

<MatmulShapeK>
    kv=gemm_K 32:
    kv=gemm_K 64:
    kv=gemm_K 128:
    kv=gemm_K 256:

<MatmulShapeB>
    kv=gemm_B 1:
    kv=gemm_B 2:

<MatmulShapeMN>
    kv=gemm_M 1024: * kv=gemm_N 1024:
    kv=gemm_M 1024: * kv=gemm_N 32:

<MatmulUnfriendylyAlighmentShape>
    kv=gemm_M 1024: * kv=gemm_N 4:
    kv=gemm_M 1024: * kv=gemm_N 8:
    kv=gemm_M 1024: * kv=gemm_N 16:

<MatmulLayout>
    kv=gemm_layout_A ROW_MAJOR: * kv=gemm_layout_B COL_MAJOR: * kv=gemm_layout_C ROW_MAJOR:
    kv=gemm_layout_A ROW_MAJOR: * kv=gemm_layout_B ROW_MAJOR: * kv=gemm_layout_C ROW_MAJOR:
    kv=gemm_layout_A COL_MAJOR: * kv=gemm_layout_B COL_MAJOR: * kv=gemm_layout_C ROW_MAJOR:
    kv=gemm_layout_A COL_MAJOR: * kv=gemm_layout_B ROW_MAJOR: * kv=gemm_layout_C ROW_MAJOR:

